// Puesto / rol que busca el trabajador. Definido con el cliente para el sector
// belleza; cada puesto abre su propio bloque de técnicas (ver cv-tecnicas.ts).
enum PuestoTalento {
  ESTETICISTA
  PELUQUERO
  BARBERO
  MANICURISTA
  MAQUILLADOR
  MASAJISTA
  RECEPCIONISTA
  OTROS

  @@schema("public")
}

enum JornadaTalento {
  COMPLETA
  PARCIAL
  POR_HORAS

  @@schema("public")
}

enum DisponibilidadTalento {
  INMEDIATA
  CON_PREAVISO
  FINES_DE_SEMANA
  A_CONVENIR

  @@schema("public")
}

// Salary expectation as fixed ranges (client request) instead of free text.
enum ExpectativaSalarial {
  SEGUN_CONVENIO
  R_1200_1500
  R_1500_1800
  R_1800_MAS

  @@schema("public")
}

// Bellezista Talent: a candidate CV bank, NOT an Anuncio subtype. Workers fill
// one standardized CV (one per worker, hence @unique); business owners browse
// them and pay to access the full profile/contact (paywall added with Stripe).
// No price, no estado, no Conversacion -- so it lives outside the Anuncio model.
model Cv {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @unique @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nombre           String? // nombre del candidato (mostrado tras el desbloqueo)
  puesto           PuestoTalento
  provincia        String
  aniosExperiencia Int                   @map("anios_experiencia")
  jornada          JornadaTalento        @default(POR_HORAS)
  disponibilidad   DisponibilidadTalento @default(A_CONVENIR)

  expectativaSalarial ExpectativaSalarial? @map("expectativa_salarial")
  titulacion          String? // titulación / formación reglada
  cursos              String? // cursos o certificaciones específicas
  presentacion        String? @db.Text // texto breve de presentación (~300)
  foto                String?

  // Bloque específico según puesto: checklist de técnicas / aparatología.
  tecnicas CvTecnica[]

  // Business owners who have paid to unlock this CV's full profile.
  desbloqueos CvDesbloqueo[]

  // Whether the CV appears in the talento catalog. Workers can hide it.
  visible Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([puesto])
  @@index([provincia])
  @@map("cv")
  @@schema("public")
}

// One row per technique the worker declares knowing, within the block that
// matches their puesto. The technique catalog (keys + labels + which puesto)
// lives in code (cv-tecnicas.ts), not the DB, so it stays easy to extend.
model CvTecnica {
  id    String @id @default(uuid()) @db.Uuid
  cvId  String @map("cv_id") @db.Uuid
  cv    Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  tecnica String // clave de la técnica (p. ej. "balayage")
  anios   Int    @default(0) @map("anios")

  @@unique([cvId, tecnica])
  @@index([cvId])
  @@index([tecnica])
  @@map("cv_tecnica")
  @@schema("public")
}

// Pay-to-access: a business owner unlocks a CV, gaining permanent access to its
// full profile (formación, técnicas, presentación, nombre) and the internal
// messaging with the candidate. Granted either by a direct Stripe payment or by
// spending a "bono" credit.
model CvDesbloqueo {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cvId      String  @map("cv_id") @db.Uuid
  cv        Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@unique([usuarioId, cvId])
  @@index([usuarioId])
  @@index([cvId])
  @@map("cv_desbloqueo")
  @@schema("public")
}

// Prepaid unlock credits from buying a "bono de varios desbloqueos". One row per
// owner; saldo is decremented each time a credit is spent to unlock a CV.
model TalentoCredito {
  usuarioId String  @id @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  saldo     Int     @default(0)

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("talento_credito")
  @@schema("public")
}

// Ledger of processed Stripe checkout sessions -- gives idempotency (a retried
// webhook can't double-grant) and a basic audit trail of Talento payments.
model TalentoPago {
  id              String  @id @default(uuid()) @db.Uuid
  stripeSessionId String  @unique @map("stripe_session_id")
  usuarioId       String  @map("usuario_id") @db.Uuid
  tipo            String // "individual" | "bono"
  cvId            String? @map("cv_id") @db.Uuid
  creditos        Int     @default(0)
  importe         Int     @default(0) // céntimos
  moneda          String  @default("eur")

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@map("talento_pago")
  @@schema("public")
}
