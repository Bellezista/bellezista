// Puesto / rol que busca el trabajador. Definido con el cliente para el sector
// belleza; cada puesto abre su propio bloque de técnicas (ver cv-tecnicas.ts).
enum PuestoTalento {
  ESTETICISTA
  PELUQUERO
  BARBERO
  MANICURISTA
  MAQUILLADOR
  MASAJISTA
  RECEPCIONISTA
  OTROS

  @@schema("public")
}

enum JornadaTalento {
  COMPLETA
  PARCIAL
  POR_HORAS

  @@schema("public")
}

enum DisponibilidadTalento {
  INMEDIATA
  CON_PREAVISO
  FINES_DE_SEMANA
  A_CONVENIR

  @@schema("public")
}

// Bellezista Talent: a candidate CV bank, NOT an Anuncio subtype. Workers fill
// one standardized CV (one per worker, hence @unique); business owners browse
// them and pay to access the full profile/contact (paywall added with Stripe).
// No price, no estado, no Conversacion -- so it lives outside the Anuncio model.
model Cv {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @unique @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  puesto           PuestoTalento
  provincia        String
  aniosExperiencia Int                   @map("anios_experiencia")
  jornada          JornadaTalento        @default(POR_HORAS)
  disponibilidad   DisponibilidadTalento @default(A_CONVENIR)

  expectativaSalarial String? @map("expectativa_salarial") // rango, opcional
  titulacion          String? // titulación / formación reglada
  cursos              String? // cursos o certificaciones específicas
  presentacion        String? @db.Text // texto breve de presentación (~300)
  foto                String?

  // Bloque específico según puesto: checklist de técnicas / aparatología.
  tecnicas CvTecnica[]

  // Whether the CV appears in the talento catalog. Workers can hide it.
  visible Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([puesto])
  @@index([provincia])
  @@map("cv")
  @@schema("public")
}

// One row per technique the worker declares knowing, within the block that
// matches their puesto. The technique catalog (keys + labels + which puesto)
// lives in code (cv-tecnicas.ts), not the DB, so it stays easy to extend.
model CvTecnica {
  id    String @id @default(uuid()) @db.Uuid
  cvId  String @map("cv_id") @db.Uuid
  cv    Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  tecnica String // clave de la técnica (p. ej. "balayage")
  anios   Int    @default(0) @map("anios")

  @@unique([cvId, tecnica])
  @@index([cvId])
  @@index([tecnica])
  @@map("cv_tecnica")
  @@schema("public")
}
