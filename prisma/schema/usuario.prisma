enum RolUsuario {
  USUARIO
  ADMIN

  @@schema("public")
}

model Usuario {
  // Same UUID as Supabase's auth.users.id -- no @default, the value is set by
  // the auth.users -> public.usuario sync trigger (see supabase/migrations).
  id     String @id @db.Uuid
  nombre String
  rol    RolUsuario @default(USUARIO)

  // Additive beyond the client's literal field list (see plan's "Open items to
  // flag to the client") -- required by the already-confirmed "admin manages
  // users" feature.
  suspendido Boolean @default(false)

  // Opt-in consent (given at registration) to receive marketing/advertising
  // communications. Separate from the cookie banner. Set by the signup trigger
  // from raw_user_meta_data.acepta_publicidad.
  aceptaPublicidad Boolean @default(false) @map("acepta_publicidad")

  // Stripe Connect (Express) account for receiving payouts as a seller in the
  // commission-with-retention flow. `cobrosActivos` caches Stripe's
  // payouts_enabled so the buy flow can gate on it without an API round-trip
  // (kept in sync by the account.updated webhook + refreshEstadoConnect).
  stripeConnectId String?  @unique @map("stripe_connect_id")
  cobrosActivos   Boolean  @default(false) @map("cobros_activos")

  creadoEn DateTime @default(now()) @map("creado_en")

  anuncios Anuncio[]
  contacto Contacto?
  cv       Cv?

  // Talento pay-to-access: CVs this user (a business owner) has unlocked, plus
  // their balance of prepaid "bono" unlock credits.
  desbloquesCv    CvDesbloqueo[]
  talentoCredito  TalentoCredito?

  kitsTraspaso       KitTraspaso[]
  solicitudesGestion SolicitudGestion[]
  alertas            Alerta[]
  notificaciones     Notificacion[]
  suscripcionPro     SuscripcionPro?

  conversacionesInteresado  Conversacion[] @relation("interesado")
  conversacionesPropietario Conversacion[] @relation("propietario")
  mensajes                  Mensaje[]

  operacionesVendidas  Operacion[] @relation("vendedor")
  operacionesCompradas Operacion[] @relation("comprador")

  ofertas Oferta[]

  @@map("usuario")
  @@schema("public")
}

// The one table the non-negotiable security requirement is about. Lives in the
// `private` Postgres schema (see schema.prisma's datasource block) so it is
// never reachable via Supabase's auto-generated PostgREST API, regardless of
// RLS. No Server Action outside src/lib/actions/contacto.ts may ever query this
// model -- see the plan's security section for the full rationale.
model Contacto {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  telefono      String?
  email         String
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("contacto")
  @@schema("private")
}
