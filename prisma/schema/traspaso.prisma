// Business-type of a traspaso listing. Exact list confirmed by the client.
enum TipoNegocioTraspaso {
  CENTRO_ESTETICA
  PELUQUERIA
  BARBERIA
  CLINICA_MEDICINA_ESTETICA
  OTRAS_CLINICAS
  SALON_MANICURA
  SALON_MASAJES
  SALON_BELLEZA
  OTROS

  @@schema("public")
}

// Who is publishing. Drives the free-vs-paid model (particulares can publish
// free; profesionales/inmobiliarias move to subscription plans in a later
// phase). Kept on the subtype so it doesn't touch the shared Anuncio table.
enum TipoAnuncianteTraspaso {
  PARTICULAR
  PROFESIONAL
  INMOBILIARIA

  @@schema("public")
}

// Type of licence transferred with the business. Every traspaso includes a
// licence, so it's a type (not a yes/no) -- list confirmed by the client.
enum TipoLicenciaTraspaso {
  SALON_BELLEZA
  CENTRO_ESTETICA
  PELUQUERIA
  SANITARIA
  OTROS

  @@schema("public")
}

// Fase 2 subtype: business-transfer listings. 1:1 with Anuncio, keyed by the
// same id (class-table inheritance, see anuncio.prisma). The traspaso price,
// ciudad/provincia, fotos, estado and propietario all live on the parent
// Anuncio -- only the traspaso-specific fields live here.
model Traspaso {
  anuncioId String  @id @map("anuncio_id") @db.Uuid
  anuncio   Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  tipoNegocio    TipoNegocioTraspaso    @map("tipo_negocio")
  tipoAnunciante TipoAnuncianteTraspaso @default(PARTICULAR) @map("tipo_anunciante")

  descripcion String? @db.Text

  // What a buyer actually looks at (from the client's Traspasos screen spec).
  metrosCuadrados Int?     @map("metros_cuadrados")
  cabinas         Int?
  personal        Int? // empleados / personal a subrogar
  alquilerMensual Decimal? @db.Decimal(12, 2) @map("alquiler_mensual")
  tipoLicencia    TipoLicenciaTraspaso? @map("tipo_licencia")

  @@index([tipoNegocio])
  @@map("traspaso")
  @@schema("public")
}

// Kit Traspaso: a one-off paid service where Bellezista (SoluciónOK) prepares
// the reservation + transfer documents for a seller. The web only sells/charges
// and stores the details the seller submits; the documents are done by hand.
model KitTraspaso {
  id              String  @id @default(uuid()) @db.Uuid
  usuarioId       String  @map("usuario_id") @db.Uuid
  usuario         Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anuncioId       String? @map("anuncio_id") @db.Uuid

  stripeSessionId String? @unique @map("stripe_session_id")
  importe         Int     @default(0)
  moneda          String  @default("eur")

  // pendiente_pago -> pagado -> datos_enviados
  estado String @default("pendiente_pago")

  // Free-form details the seller submits after paying, for SoluciónOK to draft
  // the documents. Photos of the business live alongside as a URL array.
  datos Json?
  fotos String[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([usuarioId])
  @@map("kit_traspaso")
  @@schema("public")
}

// Lead captured when a Barcelona particular requests SoluciónOK's free
// professional management of their traspaso (10% a éxito, added on top of the
// seller's price). SoluciónOK follows up by hand.
model SolicitudGestion {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  titulo    String?
  precio    Decimal? @db.Decimal(12, 2)
  provincia String?
  estado    String   @default("pendiente") // pendiente | contactado

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@map("solicitud_gestion")
  @@schema("public")
}
