enum TipoAnuncio {
  MAQUINARIA
  TRASPASO
  // Fase 2 additions still pending: TALENT, OFERTA.
  // Adding a case here + a new 1:1 subtype table + a new subtype-adapter is
  // the whole extension path -- see src/lib/anuncio/subtype-adapters.ts.

  @@schema("public")
}

enum EstadoAnuncio {
  ACTIVO
  DESTACADO
  RESERVADO
  VENDIDO
  RETIRADO

  @@schema("public")
}

// Shared parent type for all listing modules (class-table inheritance: Prisma
// has no native polymorphism, so each subtype is a separate 1:1 table keyed by
// the same id, discriminated by `tipo`). This is what lets the catalog/search
// run over a single query as more modules are added later, without duplicating
// screens or workflows -- the idea the client's brief and the winning bid were
// built around.
model Anuncio {
  id              String        @id @default(uuid()) @db.Uuid
  tipo            TipoAnuncio
  titulo          String
  precio          Decimal       @db.Decimal(12, 2)
  ciudadProvincia String        @map("ciudad_provincia")
  fotos           String[]
  estado          EstadoAnuncio @default(ACTIVO)

  propietarioId String  @map("propietario_id") @db.Uuid
  propietario   Usuario @relation(fields: [propietarioId], references: [id])

  // Additive beyond the client's literal field list -- required by the
  // already-confirmed "user panel shows view counts" feature.
  vistas Int @default(0)

  // Paid "destacado": the listing is featured (gold frame, sorted first) while
  // this timestamp is in the future. Null / past = not featured.
  destacadoHasta DateTime? @map("destacado_hasta")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  maquinaria Maquinaria?
  traspaso   Traspaso?
  // Fase 2 remaining: talent Talent?, oferta Oferta? -- same additive pattern.

  conversaciones Conversacion[]
  operaciones    Operacion[]
  pagos          PagoAnuncio[]

  @@index([tipo, estado])
  @@index([ciudadProvincia])
  @@map("anuncio")
  @@schema("public")
}

// Ledger of simple one-off anuncio payments (destacado, Kit Traspaso). Gives
// idempotency (unique stripe_session_id) and a basic audit trail. The commission
// -with-retention flow uses Operacion instead; this is only for simple checkouts.
model PagoAnuncio {
  id              String  @id @default(uuid()) @db.Uuid
  stripeSessionId String  @unique @map("stripe_session_id")
  anuncioId       String  @map("anuncio_id") @db.Uuid
  anuncio         Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  usuarioId       String  @map("usuario_id") @db.Uuid

  tipo    String // "destacado" | "kit_traspaso"
  importe Int    @default(0) // céntimos
  moneda  String @default("eur")
  dias    Int?   // duración del destacado, en días

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([anuncioId])
  @@index([usuarioId])
  @@map("pago_anuncio")
  @@schema("public")
}
