enum EstadoOferta {
  PENDIENTE_DE_PAGO
  ACTIVA
  CADUCADA

  @@schema("public")
}

enum VigenciaOferta {
  DIARIA
  SEMANAL

  @@schema("public")
}

// Ofertas module: a beauty business pays to publish a single promotion (a
// service or pack) that lives on its OWN standalone landing page (/o/[slug]),
// outside the B2B catalog and app shell -- no nav, no search. The business
// shares that URL on Instagram, WhatsApp, Google Business, etc. There is no
// commission on the treatment; billing is pay-per-active-offer (daily/weekly).
// Deliberately NOT an Anuncio subtype: it never appears in the browsable catalog.
model Oferta {
  id             String @id @default(uuid()) @db.Uuid
  slug           String @unique
  titulo         String
  descripcion    String
  // Euros. `precio` is the discounted price; `precioOriginal` (optional) is
  // shown struck-through next to it.
  precio         Decimal  @db.Decimal(12, 2)
  precioOriginal Decimal? @db.Decimal(12, 2) @map("precio_original")
  // Same 9 business types as Traspasos (reused enum).
  tipoNegocio     TipoNegocioTraspaso @map("tipo_negocio")
  foto            String
  whatsapp        String // phone in international format, e.g. 34600111222
  ciudadProvincia String? @map("ciudad_provincia")

  vigencia       VigenciaOferta
  estado         EstadoOferta @default(PENDIENTE_DE_PAGO)
  // Set on payment (now + 1 day / 7 days). The landing hides the offer once
  // this passes; the cron marks it CADUCADA.
  fechaCaducidad DateTime? @map("fecha_caducidad")

  propietarioId String  @map("propietario_id") @db.Uuid
  propietario   Usuario @relation(fields: [propietarioId], references: [id])

  stripeSessionId String? @unique @map("stripe_session_id")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([propietarioId])
  @@map("oferta")
  @@schema("public")
}
