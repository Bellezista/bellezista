// In-app notification shown in the bell + /notificaciones page. Created on key
// events: new message, new contact on your listing, CV unlocked.
model Notificacion {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo   String // mensaje | contacto | desbloqueo
  titulo String
  cuerpo String?
  url    String?
  leida  Boolean @default(false)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([usuarioId, leida])
  @@map("notificacion")
  @@schema("public")
}
